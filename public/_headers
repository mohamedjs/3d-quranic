# Cloudflare Pages response headers (this file is not served and not precached)

# Hashed build files never change: cache for a year
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The service worker and the app shell must always be checked for updates
/sw.js
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
  Content-Type: application/manifest+json

# Models, audio, pictures: cache a day, then revalidate
/models/*
  Cache-Control: public, max-age=86400
/audio/*
  Cache-Control: public, max-age=86400
/illustrations/*
  Cache-Control: public, max-age=86400

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
