"yusuf-dream/player-29ecc413c7",
"yusuf-dream/player-5e8f0b62d5"
],
"صحيح، كان فيه فيلٌ كبير! اسمع القصة من أولها، واسألنا عمّا تريد.": "audio/people-of-the-elephant/zainab-a8ed9bfedf.mp3",
"منذ زمنٍ بعيد، قبل أن يُبعث نبيّنا محمد ﷺ، كانت في مكة الكعبةُ، بيتُ الله الذي بناه إبراهيم وإسماعيل عليهما السلام، وكان الناس يأتون إليها من كل مكان.": "audio/people-of-the-elephant/zainab-ed04ee6ea3.mp3",
"يا جدّي، سمعتُ اسم «أبرهة». مَن هو أبرهة؟": "audio/people-of-the-elephant/player-7983631745.mp3",
"أبرهة كان حاكمًا على اليمن من قِبَل ملك الحبشة. بنى في صنعاء كنيسةً كبيرةً مزخرفة، وأراد أن يترك العربُ الكعبةَ ويحجّوا إليها بدلًا منها.": "audio/people-of-the-elephant/farmer-5a9d11d35d.mp3",
"ولماذا أراد أن يهدم الكعبة؟": "audio/people-of-the-elephant/player-626f24b52f.mp3",
"لأن العرب ظلّوا يحبّون الكعبة ويقصدونها، ولم يتركوها من أجل كنيسته. فغضب أبرهة غضبًا شديدًا، وأقسم أن يسير إلى مكة ويهدمها.": "audio/people-of-the-elephant/zainab-f1bda3fbba.mp3",
"فخرج بجيشٍ عظيم، ومعه فيلٌ ضخم اسمه «محمود». ولمّا اقتربوا من مكة، أخذ جنودُه إبلَ أهلها، ومنها مئتا بعيرٍ لعبد المطّلب، جدّ النبي ﷺ وسيّد قريش.": "audio/people-of-the-elephant/farmer-3da05e7eef.mp3",
"وماذا قال عبد المطّلب لأبرهة؟": "audio/people-of-the-elephant/player-2224d11ec2.mp3",
"ذهب إليه وطلب أن يردّ عليه إبله. فتعجّب أبرهة وقال: تكلّمني في إبلك، وتترك البيت الذي هو دينك ودين آبائك؟": "audio/people-of-the-elephant/zainab-93334c25a1.mp3",
"فقال عبد المطّلب: «أنا ربُّ الإبل، وللبيت ربٌّ يحميه». يعني: أنا صاحب الإبل، أمّا الكعبة فلها ربٌّ يحفظها، وهو الله. ثم أمر أهلَ مكة أن يحتموا في الجبال، ووقف عند باب الكعبة يدعو الله.": "audio/people-of-the-elephant/farmer-46b23d44c7.mp3",
"وماذا فعل الفيل محمود لمّا وجّهوه نحو مكة؟": "audio/people-of-the-elephant/player-626d6a8981.mp3",
"في الصباح جهّزوه ووجّهوه نحو مكة، فبَرَك على الأرض ولم يتحرّك! ضربوه ليقوم فأبى. فإذا وجّهوه نحو اليمن قام يُسرع، وإذا وجّهوه نحو مكة برك من جديد.": "audio/people-of-the-elephant/farmer-6eaf1e942a.mp3",
"مَن تظنّ الذي منع الجيش وحمى الكعبة؟": "audio/people-of-the-elephant/zainab-cfc4682c46.mp3",
"تذكّر كلمة عبد المطّلب: «وللبيت ربٌّ يحميه»…": "audio/people-of-the-elephant/zainab-4e8d276f5f.mp3",
"أحسنت يا حبيبي! الله هو الذي حمى بيته.": "audio/people-of-the-elephant/zainab-7be2140bdd.mp3",
"وما هي الطير الأبابيل يا جدّتي؟": "audio/people-of-the-elephant/player-ea5078782a.mp3",
"أرسل الله عليهم من ناحية البحر طيورًا كثيرة، جماعاتٍ وراء جماعات — وهذا معنى «أبابيل». مع كل طائرٍ ثلاثة أحجار صغيرة: حجرٌ في منقاره، وحجران في رجليه، مثل حبّ الحمّص والعدس.": "audio/people-of-the-elephant/zainab-7663c96068.mp3",
"وكانت الحجارة «من سِجّيل»، أي من طينٍ متحجّر. فرمتهم الطير بها، فلا يُصيب حجرٌ أحدًا منهم إلا هلك، وأصاب أبرهةَ أيضًا فهلك. ولم يصلوا إلى الكعبة أبدًا.": "audio/people-of-the-elephant/farmer-828071d3ef.mp3",
"وما معنى «كعصفٍ مأكول»؟": "audio/people-of-the-elephant/player-d6643f656f.mp3",
"العَصْف هو ورق الزرع وقشّه اليابس، مثل التبن الذي تأكله البهائم في الغيط. فصار الجيش مثل القشّ الذي أكلته الدوابّ ورمته مُفتّتًا. هكذا أفسد الله كيدهم.": "audio/people-of-the-elephant/zainab-c04437e6d6.mp3",
"ومتى وُلد النبي ﷺ؟": "audio/people-of-the-elephant/player-9b9a6245e8.mp3",
"في ذلك العام نفسه وُلد نبيّنا محمد ﷺ، ولذلك سمّاه العرب «عام الفيل»، وكان نحو سنة ٥٧٠ للميلاد.": "audio/people-of-the-elephant/farmer-aaa87bc411.mp3",
"وقد حكى الله لنا هذه القصة في سورةٍ قصيرة اسمها سورة الفيل. تعالَ نسمع الآيات بصوت الشيخ.": "audio/people-of-the-elephant/zainab-f5d4dab45d.mp3",
"رأيتَ يا بُنيّ؟ الله يحمي بيته، ولا أحدَ أقوى من الله، مهما كان جيشه كبيرًا وفيله ضخمًا.": "audio/people-of-the-elephant/farmer-aae848a1b7.mp3",
"فماذا نتعلّم من هذه القصة؟": "audio/houses-by-their-doors/hamdan-fb96e8306f.mp3",
"فكّر: هل استطاع الجيش الكبير أن يهدم الكعبة؟": "audio/people-of-the-elephant/zainab-f3977c4303.mp3",
"ممتاز! وإذا خفتَ من شيء، فتوكّل على الله، فهو يحفظ مَن يتوكّل عليه.": "audio/people-of-the-elephant/zainab-9041981b39.mp3",
"سأتذكّر دائمًا: الله أقوى من كل شيء!": "audio/people-of-the-elephant/player-6346a54cac.mp3",
"أهلًا وسهلًا! رجعتُ للتوّ من سفر طويل مع جملي.": "audio/quraysh-journeys/hamdan-5facc285a2.mp3",
"كلّما أكلت وشبعت، قل: الحمد لله!": "audio/quraysh-journeys/hamdan-f0a263c3ad.mp3",
"أهلًا وسهلًا! هل تحبّ السفر والقوافل؟": "audio/quraysh-journeys/hamdan-5151198609.mp3",
"كانت هناك قبيلة تسافر كل عام رحلتين كبيرتين. هل تريد أن تعرف قصتها؟": "audio/quraysh-journeys/hamdan-28ed0bf3bb.mp3",
"نعم!": "audio/quraysh-journeys/player-81ee8ae187.mp3",
"إلى أين كانوا يسافرون؟": "audio/quraysh-journeys/player-869a95ecf5.mp3",
"في مكة عاشت قبيلة قريش، قبيلة النبي ﷺ. ومكة وادٍ جاف لا يكاد ينبت فيه زرع.": "audio/quraysh-journeys/hamdan-bb744e8024.mp3",
"فكانت قوافلهم تسافر في الشتاء إلى اليمن، وفي الصيف إلى الشام، للتجارة ولجلب الطعام.": "audio/quraysh-journeys/hamdan-4be4500f66.mp3",
"وكانوا يسافرون آمنين، لأن الناس كانوا يحترمونهم لأنهم أهل مكة، جيران بيت الله.": "audio/quraysh-journeys/hamdan-ac92152258.mp3",
"مَن الذي أعطى قريشًا الطعام والأمان؟": "audio/quraysh-journeys/hamdan-164d70236b.mp3",
"الجِمال تحمل الطعام… لكن مَن الذي خلق الطعام وحفظ الطريق؟": "audio/quraysh-journeys/hamdan-7cc05d99e7.mp3",
"صحيح! كل النِّعَم من الله.": "audio/quraysh-journeys/hamdan-69379e0186.mp3",
"ذكّرهم الله بهذه النِّعَم في سورة قريش، وهي السورة التي بعد سورة الفيل مباشرة. اسمع!": "audio/quraysh-journeys/hamdan-4d4d9ea21e.mp3",
"أطعمهم الله من جوع، وآمنهم من خوف، فأمرهم أن يعبدوا ربّ هذا البيت. وكذلك نحن: نشكر الله على الطعام والأمان ونعبده.": "audio/quraysh-journeys/hamdan-9c7ca6eed5.mp3",
"عندما تأكل طعامًا لذيذًا وتشبع، ماذا تقول؟": "audio/quraysh-journeys/hamdan-94f1f1c3ad.mp3",
"نشكر مَن أعطانا الطعام…": "audio/quraysh-journeys/hamdan-9aecd37baa.mp3",
"أحسنت! الحمد لله على كل نعمة.": "audio/quraysh-journeys/hamdan-55677a7097.mp3",
"السلام عليكم يا حبيبي! تعالَ استرِح في الظلّ.": "audio/yusuf-dream/amina-75c32eebf5.mp3",
"احكِ لأبيك وأمك دائمًا عمّا يهمّك، فهم يحبونك.": "audio/yusuf-dream/amina-65a86dfcb1.mp3",
"السلام عليكم يا حبيبي! اجلس هنا في ظلّ النخيل.": "audio/yusuf-dream/amina-ff92add876.mp3",
"هل تتذكّر أحلامك عندما تستيقظ؟": "audio/yusuf-dream/amina-14464dd5c9.mp3",
"نعم، أحيانًا!": "audio/yusuf-dream/player-29ecc413c7.mp3",
"لا، أنساها": "audio/yusuf-dream/player-5e8f0b62d5.mp3",
"كان هناك ولدٌ اسمه يوسف، ابن النبي يعقوب عليهما السلام. رأى يوسف في منامه أحد عشر كوكبًا والشمس والقمر، يسجدون له!": "audio/yusuf-dream/amina-af61d82a36.mp3",
"فحكى يوسف رؤياه لأبيه. وكان أبوه يعقوب يحبّه كثيرًا، فقال له: يا بُنيّ، لا تحكِ رؤياك لإخوتك، لئلا يحسدوك ويكيدوا لك.": "audio/yusuf-dream/amina-0a497e61ed.mp3",
"لِمَن حكى يوسف رؤياه؟": "audio/yusuf-dream/amina-87312b9198.mp3",
"حكاها لمن يحبّه كثيرًا وينصحه…": "audio/yusuf-dream/amina-4044e16b8b.mp3",
"أحسنت! حكاها لأبيه.": "audio/yusuf-dream/amina-ea92ece7ff.mp3",
"والله يحكي لنا هذا في سورة يوسف. تعالَ نسمع الآيتين.": "audio/yusuf-dream/amina-a2745afcbd.mp3",
"نتعلّم من يوسف أن نحكي أسرارنا وما يقلقنا لآبائنا وأمهاتنا، فهم يحبوننا وينصحوننا. وقد تحقّقت رؤيا يوسف بعد سنوات طويلة — وهذه قصة جميلة ستسمع بقيّتها يومًا ما!": "audio/yusuf-dream/amina-eb2b15a893.mp3",
"إذا كان عندك أمرٌ مهمّ، لِمَن تحكيه؟": "audio/yusuf-dream/amina-fe9493a082.mp3",
"مثل يوسف: مَن يحبّك أكثر من الجميع؟": "audio/yusuf-dream/amina-8f94abfe09.mp3",
"رائع! هكذا فعل يوسف.": "audio/yusuf-dream/amina-8a5a2c42bd.mp3",
"أهلًا يا حبيبي! تعالَ، عندي لك حكاية عن خيطين عجيبين.": "audio/threads-of-dawn/amina-28b913e772.mp3",
"إذا لم تفهم شيئًا، فاسأل مَن يعلم — هكذا نتعلّم.": "audio/threads-of-dawn/amina-df48e958d7.mp3",
"أهلًا يا حبيبي! كنتُ أنظر من هذه النافذة إلى السماء قبل الفجر. هل تعلم أنّ في القرآن آيةً فيها خيطٌ أبيض وخيطٌ أسود؟": "audio/threads-of-dawn/amina-1c33cd0f15.mp3",
"هل تحبّ أن تسمع قصتهما؟": "audio/threads-of-dawn/amina-542976850c.mp3",
"نعم يا جدّتي، احكي لي!": "audio/threads-of-dawn/player-adcf12c14c.mp3",
"اسمع إذن، وكلّما خطر لك سؤالٌ فاسأل.": "audio/threads-of-dawn/amina-cb2b5c9e7d.mp3",
"خيوط؟ مثل خيوط الخياطة؟": "audio/threads-of-dawn/player-976e3cb957.mp3",
"سؤالٌ جميل! وهذا بالضبط ما ظنّه بعض الناس أوّل مرة. اسمع القصة.": "audio/threads-of-dawn/amina-bb0abdec7e.mp3",
"في رمضان نصوم من الفجر إلى المغرب. وقد حكى الصحابيّ سهل بن سعد رضي الله عنه أنّه لمّا نزل قول الله تعالى: «وكلوا واشربوا حتى يتبيّن لكم الخيطُ الأبيض من الخيطِ الأسود»، لم تكن قد نزلت بعدُ كلمة «من الفجر».": "audio/threads-of-dawn/amina-7553c0fdec.mp3",
"وماذا فعل الناس لمّا سمعوا هذه الآية؟": "audio/threads-of-dawn/player-3ca8ab13f4.mp3",
"قال سهل رضي الله عنه: كان رجالٌ إذا أرادوا الصوم ربط أحدُهم في رِجله الخيطَ الأبيض والخيطَ الأسود.": "audio/threads-of-dawn/amina-87d22e9ab9.mp3",
"ولم يزل يأكل حتى يتبيّن له الخيطان ويستطيع أن يراهما.": "audio/threads-of-dawn/amina-67a8a78e70.mp3",
"خيطٌ حقيقي في رِجله؟ وهل كان يراه في الظلام؟": "audio/threads-of-dawn/player-2921d502d7.mp3",
"في ظلام الليل لا تكاد تفرّق بين الخيطين. فكان ينتظر حتى يصير الضوء كافيًا ليرى الأبيض من الأسود. هكذا فهموا الآية أوّل مرة.": "audio/threads-of-dawn/amina-20de33430e.mp3",
"وكيف عرفوا المعنى الصحيح؟": "audio/threads-of-dawn/player-346ff8ae18.mp3",
"أنزل الله بعد ذلك كلمة «مِنَ الفجر». قال سهل رضي الله عنه: فعلموا أنّه يعني الليل والنهار.": "audio/threads-of-dawn/amina-64f690c62b.mp3",
"فالخيط الأبيض هو بياض النهار الذي يظهر في الأفق عند الفجر، والخيط الأسود هو سواد الليل. خطٌّ رفيعٌ من نور، يرسمه الله في السماء كلّ صباح!": "audio/threads-of-dawn/amina-8d6c4bae46.mp3",
"ما المقصود بالخيط الأبيض والخيط الأسود في الآية؟": "audio/threads-of-dawn/amina-83cdd6dfa1.mp3",
"تذكّر الكلمة التي نزلت بعد ذلك: «من الفجر»…": "audio/threads-of-dawn/amina-9dc26fa4ad.mp3",
"أحسنت يا حبيبي! هما ضوء الفجر وظلمة الليل.": "audio/threads-of-dawn/amina-3807159a84.mp3",
"إذن متى نتوقّف عن السحور؟": "audio/threads-of-dawn/player-4f5aa6700a.mp3",
"نتسحّر في الليل — تمرًا وماءً ولبنًا — فإذا طلع الفجر وظهر ذلك الخيط الأبيض في الأفق، أمسكنا عن الطعام والشراب حتى المغرب.": "audio/threads-of-dawn/amina-70b5404906.mp3",
"تعالَ نسمع هذا الجزء من الآية بصوت الشيخ. انتبه لكلمة «مِنَ الفجر»!": "audio/threads-of-dawn/amina-62153ada61.mp3",
"رأيتَ؟ الصحابة رضي الله عنهم أرادوا أن يطيعوا الله تمامًا، ولمّا لم يتّضح لهم المعنى، بيّنه الله لهم برحمته.": "audio/threads-of-dawn/amina-4df9ba154c.mp3",
"تذكّر: لمّا لم يتّضح المعنى للصحابة… ماذا حدث؟": "audio/threads-of-dawn/amina-72e2fd0d8e.mp3",
"ممتاز! نسأل أهل العلم ونتعلّم، والله يبيّن لنا.": "audio/threads-of-dawn/amina-ee122dd3a1.mp3",
"سأنظر إلى الأفق عند الفجر لأرى الخيط الأبيض!": "audio/threads-of-dawn/player-8d3ae932fc.mp3",
"أهلًا يا بُنيّ! تعبتُ اليوم في الغيط… تعالَ، أحكي لك عن فلاحٍ صائمٍ مثلي.": "audio/qays-the-fasting-farmer/farmer-3fab7368b0.mp3",
"الله رحيمٌ بنا يا بُنيّ، يحبّ لنا اليُسر.": "audio/qays-the-fasting-farmer/farmer-56c0ae793e.mp3",
"أهلًا يا بُنيّ! انظر، الشمس تميل إلى الغروب، وهذا وقتٌ يرجع فيه الفلاحون إلى بيوتهم. أتعرف أنّ فلاحًا صائمًا كان سببًا في نزول آيةٍ من القرآن؟": "audio/qays-the-fasting-farmer/farmer-2472120176.mp3",
"هل تريد أن تسمع قصته؟": "audio/qays-the-fasting-farmer/farmer-a2d579eb20.mp3",
"نعم يا جدّي، احكِ لي!": "audio/qays-the-fasting-farmer/player-d22ee38f19.mp3",
"اسمع يا بُنيّ، واسأل عمّا تريد.": "audio/qays-the-fasting-farmer/farmer-84a90b61bf.mp3",
"فلاحٌ صائم؟ مثلك يا جدّي؟": "audio/qays-the-fasting-farmer/player-44be6a4067.mp3",
"نعم، كان يعمل في أرضه مثلي تمامًا! اسمع القصة.": "audio/qays-the-fasting-farmer/farmer-67f70a3706.mp3",
"حكى البراء بن عازب رضي الله عنه أنّ أصحاب النبيّ ﷺ كان لهم في الصيام أوّلَ الأمر حكمٌ غير الذي نعرفه اليوم.": "audio/qays-the-fasting-farmer/farmer-498a03f28e.mp3",
"ما هو ذلك الحكم يا جدّي؟": "audio/qays-the-fasting-farmer/player-7069eb1353.mp3",
"قال البراء رضي الله عنه: كان الرجل إذا كان صائمًا فحضر الإفطار، فنام قبل أن يُفطر، لم يأكل ليلته ولا يومه حتى يُمسي.": "audio/qays-the-fasting-farmer/farmer-174359f001.mp3",
"يعني: إذا غلبه النوم بعد المغرب قبل أن يأكل، بقي صائمًا تلك الليلة واليومَ الذي بعدها، حتى المساء!": "audio/qays-the-fasting-farmer/farmer-97f2dcec6d.mp3",
"ومَن هو الفلاح الصائم؟": "audio/qays-the-fasting-farmer/player-dae69de51f.mp3",
"رجلٌ من الأنصار اسمه قيس بن صِرمة رضي الله عنه. كان صائمًا، وكان يعمل في أرضه طولَ النهار.": "audio/qays-the-fasting-farmer/farmer-b1b2e06bf0.mp3",
"وماذا حدث لمّا جاء وقت الإفطار؟": "audio/qays-the-fasting-farmer/player-03ff6feb05.mp3",
"أتى امرأته فقال لها: أعندكِ طعام؟ قالت: لا، ولكن أنطلق فأطلب لك.": "audio/qays-the-fasting-farmer/farmer-a47f9748d6.mp3",
"وكان يومَه يعمل، فغلبته عيناه، فنام قبل أن يأكل شيئًا.": "audio/qays-the-fasting-farmer/farmer-1a20fe3d50.mp3",
"يا مسكين! وهل بقي صائمًا إلى اليوم التالي؟": "audio/qays-the-fasting-farmer/player-f647b739d6.mp3",
"نعم. فلمّا انتصف النهار غُشِيَ عليه من شدّة التعب، فذُكر ذلك للنبيّ ﷺ.": "audio/qays-the-fasting-farmer/farmer-d926fc0435.mp3",
"ماذا تظنّ أنّ الله أنزل، رحمةً بالناس؟": "audio/qays-the-fasting-farmer/farmer-59ef4cf33a.mp3",
"الله رحيمٌ بعباده، ويحبّ لهم اليُسر…": "audio/qays-the-fasting-farmer/farmer-66b949c601.mp3",
"أحسنت! فنزلت: «وكلوا واشربوا حتى يتبيّن لكم الخيطُ الأبيض من الخيطِ الأسود».": "audio/qays-the-fasting-farmer/farmer-25d24d4584.mp3",
"قال البراء رضي الله عنه: ففرحوا بها فرحًا شديدًا. فصار الصائم يأكل ويشرب في الليل كلّه — حتى لو نام ثم استيقظ — إلى أن يطلع الفجر.": "audio/qays-the-fasting-farmer/farmer-58ad09b4af.mp3",
"هذه هي الآية نفسها التي حكت لك عنها الجدّة آمنة. اسمعها مرة أخرى بصوت الشيخ، وتذكّر قيسًا الفلاح الصائم.": "audio/qays-the-fasting-farmer/farmer-b67898837c.mp3",
"الصيام عبادةٌ عظيمة، والله جعله سهلًا علينا. هو رحيمٌ بعباده، يحبّ لهم اليُسر ولا يريد أن يشقّ عليهم.": "audio/qays-the-fasting-farmer/farmer-a3b28dea9d.mp3",
"فماذا نتعلّم من قصة قيسٍ رضي الله عنه؟": "audio/qays-the-fasting-farmer/farmer-b062dd0299.mp3",
"تذكّر: كيف فرح الصحابة لمّا نزلت الآية؟": "audio/qays-the-fasting-farmer/farmer-109a1a3d35.mp3",
"ممتاز! ونشكر الله على رحمته، ونقدّر تعب الفلاحين وكل من يعمل بجدّ.": "audio/qays-the-fasting-farmer/farmer-0ff5425d48.mp3",
"الحمد لله أنّ الله رحيمٌ بنا!": "audio/qays-the-fasting-farmer/player-dde1ab461a.mp3",
"أهلًا يا صغيري! تعالَ إلى ظلّ النخيل، التمر نضج!": "audio/best-dates/hamdan-b8acb31436.mp3",
"أعطِ غيرك ما تحبّ أن تُعطى.": "audio/best-dates/hamdan-65c1abd2e5.mp3",
"أهلًا يا صغيري! انظر إلى هذه العذوق، ما أجمل التمر إذا نضج! كنتُ أنا والجدّ سالم نتذكّر قصةً عن التمر نزلت فيها آيةٌ من القرآن.": "audio/best-dates/hamdan-dafde09e12.mp3",
"هل تعرف ما هو «القِنو» يا بُنيّ؟": "audio/best-dates/farmer-0bc27340ae.mp3",
"لا، ما هو؟": "audio/best-dates/player-d6ae59aa4e.mp3",
"القِنو هو العِذق: عنقود التمر الكبير كما هو على النخلة، بعيدانه وحبّاته.": "audio/best-dates/farmer-b53e4ac7f5.mp3",
"عنقود التمر!": "audio/best-dates/player-e535b80f03.mp3",
"أحسنت! القِنو هو العِذق: عنقود التمر الكبير كما يُقطف من النخلة.": "audio/best-dates/farmer-988041c33b.mp3",
"حكى البراء بن عازب رضي الله عنه فقال: نزلت فينا معشرَ الأنصار، كنّا أصحابَ نخل.": "audio/best-dates/hamdan-3093b60d51.mp3",
"وماذا كانوا يفعلون بتمرهم؟": "audio/best-dates/player-63ff8f4283.mp3",
"قال البراء: كان الرجل يأتي من نخله على قدر كثرته وقلّته. يأتي بالقِنو والقِنوين، فيعلّقه في المسجد.": "audio/best-dates/hamdan-2679625635.mp3",
"وكان في المسجد فقراء ليس لهم طعام، هم «أهل الصُّفّة». فإذا جاع أحدهم أتى القِنو فضربه بعصاه، فيسقط البُسر والتمر فيأكل.": "audio/best-dates/farmer-e444dfa8d5.mp3",
"ما أجمل هذا! وهل كانت كلّ العذوق طيّبة؟": "audio/best-dates/player-9570d8b302.mp3",
"لا يا بُنيّ. قال البراء: وكان ناسٌ ممّن لا يرغب في الخير، يأتي الرجل بالقِنو فيه الشِّيص والحَشَف، وبالقِنو قد انكسر، فيعلّقه.": "audio/best-dates/farmer-f0fefd4c3b.mp3",
